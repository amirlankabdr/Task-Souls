@inherits LayoutComponentBase
@implements IDisposable
@inject PlayerStateService PlayerState

<CascadingValue Value="PlayerState" IsFixed="true">
<div class="page">
    <div class="sidebar"><NavMenu /></div>
    <main><div class="top-row px-4"><span class="top-status">Functional progress, made visible.</span></div><article class="content px-4">@Body</article></main>
</div>
</CascadingValue>
<div id="blazor-error-ui" data-nosnippet>An unexpected error occurred. Your saved data is safe.<a href="." class="reload">Reload</a><span class="dismiss">×</span></div>

@code { protected override void OnInitialized() => PlayerState.OnChange += StateHasChanged; public void Dispose() => PlayerState.OnChange -= StateHasChanged; }

@page "/"
@rendermode InteractiveServer
@using QuestForge.Core
@inject PlayerStateService PlayerStateService
@inject AuthenticationStateProvider AuthenticationState
@attribute [Authorize]
<PageTitle>QuestForge | Dashboard</PageTitle>
<section class="hero"><div><span class="eyebrow">YOUR ADVENTURE</span><h1>Forge progress from real life.</h1><p>Turn focused work into measurable growth. Complete quests, strengthen skills, and unlock achievements.</p></div><a class="button" href="quests">Create a quest</a></section>
<section class="stat-grid" aria-label="Player statistics"><article class="panel level-card"><span>Level</span><strong>@Progression.LevelFor(snapshot.Player.TotalXp)</strong><small>@snapshot.Player.TotalXp total XP</small></article><article class="panel"><span>Completed</span><strong>@snapshot.Player.CompletedQuests</strong><small>quests conquered</small></article><article class="panel"><span>Achievements</span><strong>@snapshot.UnlockedAchievements.Count</strong><small>of @AchievementCatalog.All.Count unlocked</small></article></section>
<section class="panel progress-panel"><div class="section-heading"><div><span class="eyebrow">NEXT LEVEL</span><h2>@Progression.XpToNextLevel(snapshot.Player.TotalXp) XP remaining</h2></div><b>@Progression.XpIntoLevel(snapshot.Player.TotalXp)%</b></div><ProgressBar Value="@Progression.XpIntoLevel(snapshot.Player.TotalXp)" Label="Player level progress" /></section>
<div class="content-grid"><section class="panel"><div class="section-heading"><h2>Recent quests</h2><a href="quests">View all</a></div>@if (snapshot.RecentQuests.Count == 0) { <div class="empty"><h3>Your journey starts here</h3><p>Create a meaningful quest and earn your first XP.</p></div> } else { @foreach (var quest in snapshot.RecentQuests) { <QuestCard Quest="quest" /> } }<div class="skill-grid">@foreach (var skill in snapshot.Player.SkillXp.OrderByDescending(x => x.Value).Take(3)) { <SkillCard Name="@skill.Key" Xp="@skill.Value" /> }</div></section><section class="panel"><div class="section-heading"><h2>Achievements</h2><span>@snapshot.UnlockedAchievements.Count/@AchievementCatalog.All.Count</span></div><div class="achievement-list">@foreach (var achievement in AchievementCatalog.All) { <AchievementBadge Achievement="achievement" Unlocked="snapshot.UnlockedAchievements.Contains(achievement.Key)" /> }</div></section></div>
@code { private DashboardSnapshot snapshot => PlayerStateService.Current; protected override async Task OnInitializedAsync() { var user = (await AuthenticationState.GetAuthenticationStateAsync()).User; var userId = user.FindFirstValue(ClaimTypes.NameIdentifier) ?? throw new InvalidOperationException("Authenticated user ID is missing."); await PlayerStateService.RefreshAsync(userId); } }

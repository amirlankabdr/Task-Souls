@using QuestForge.Core
<article class="achievement @(Unlocked ? "unlocked" : "locked")"><span>@(Unlocked ? "◆" : "◇")</span><div><h3>@Achievement.Name</h3><p>@Achievement.Description</p></div></article>
@code { [Parameter, EditorRequired] public Achievement Achievement { get; set; } = default!; [Parameter] public bool Unlocked { get; set; } }
